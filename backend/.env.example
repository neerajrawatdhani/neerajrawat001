# Server Port
PORT=5000

# Gmail SMTP Email Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Notification & Sender Details
ADMIN_EMAIL=your_email@gmail.com
FROM_NAME="Neeraj Rawat | Dhani Tech"

# Client Auto-Reply Configuration
ENABLE_CLIENT_AUTOREPLY=true
