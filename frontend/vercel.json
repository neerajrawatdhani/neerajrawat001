{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/home/(.*)", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/works", "destination": "/index.html" },
    { "source": "/my-story", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/legal", "destination": "/legal/index.html" }
  ]
}
