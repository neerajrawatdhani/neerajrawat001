{
  "cleanUrls": true,
  "redirects": [
    {
      "has": [
        { "type": "host", "value": "admin.neerajrawat.dev" }
      ],
      "source": "/",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "has": [
        { "type": "host", "value": "admin.neerajrawat.dev" }
      ],
      "source": "/",
      "destination": "/admin/index.html"
    },
    {
      "has": [
        { "type": "host", "value": "admin.neerajrawat.dev" }
      ],
      "source": "/(.*)",
      "destination": "/admin/$1"
    },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/home", "destination": "/" },
    { "source": "/home/", "destination": "/" },
    { "source": "/work", "destination": "/" },
    { "source": "/work/", "destination": "/" },
    { "source": "/works", "destination": "/" },
    { "source": "/works/", "destination": "/" },
    { "source": "/my-story", "destination": "/" },
    { "source": "/my-story/", "destination": "/" },
    { "source": "/about", "destination": "/" },
    { "source": "/about/", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/contact/", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff2|mp4|mjs)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    }
  ]
}
