{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/home", "destination": "/frontend/index.html" },
    { "source": "/home/(.*)", "destination": "/frontend/index.html" },
    { "source": "/work", "destination": "/frontend/index.html" },
    { "source": "/works", "destination": "/frontend/index.html" },
    { "source": "/my-story", "destination": "/frontend/index.html" },
    { "source": "/about", "destination": "/frontend/index.html" },
    { "source": "/contact", "destination": "/frontend/index.html" },
    { "source": "/legal", "destination": "/frontend/legal/index.html" },
    { "source": "/api/(.*)", "destination": "/backend/server.js" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
